# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile.production: Multi-Stage Production Build Using Astral's uv
# Designed for high-speed dependency resolution with requirements.txt
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Dependency Resolution (Builder Stage)
# ------------------------------------------------------------------------------
# 1. Base image: Use official uv image with Python 3.12 for fast builds and compiling C-wheels
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

# 2. Environment flags: Configure Python and uv for deterministic, fast builds
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# 3. Workdir: Isolated build context
WORKDIR /app

# 4. Compiler tools: Install build-essential only if native compilation is needed, cleaned immediately
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 5. Virtual environment: Initialize clean virtual environment for deployment
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 6. Layer caching: Copy requirements.txt and install packages with uv BEFORE copying app code
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-cache -r requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Minimal Runtime Image (Runtime Stage)
# ------------------------------------------------------------------------------
# 7. Base runtime image: Clean Debian slim image free of build compilers or uv binaries
FROM python:3.12-slim AS runtime

# 8. Runtime environment: Prepend isolated virtual environment to PATH
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# 9. Workdir: Target application directory
WORKDIR /app

# 10. System dependencies: Install curl for health monitoring probes
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 11. Security: Create dedicated unprivileged system group and user (UID 10001)
RUN groupadd --gid 10001 appgroup && \
    useradd --uid 10001 --gid appgroup --shell /bin/false --no-create-home appuser

# 12. Layer caching: Copy compiled virtual environment from builder stage before source code
COPY --from=builder /opt/venv /opt/venv

# 13. Application code: Copy source code with unprivileged user ownership
COPY --chown=appuser:appgroup . .

# 14. Security: Drop root privileges to enforce least-privilege runtime security
USER appuser

# 15. Metadata: Expose standard application port
EXPOSE 8000

# 16. Healthcheck: Probes container health every 30 seconds
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# 17. Runtime execution: Run Uvicorn ASGI server binding to 0.0.0.0 for external network reachability
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
