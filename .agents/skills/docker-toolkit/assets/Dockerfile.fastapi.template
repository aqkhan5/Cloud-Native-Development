# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile Template for FastAPI Applications
# ==============================================================================

ARG PYTHON_VERSION=3.12-slim
FROM python:${PYTHON_VERSION} AS base

# Environment configurations
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 1. Dependency installation with layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# 2. Security: Create non-root system user
RUN groupadd --gid 10001 appgroup && \
    useradd --uid 10001 --gid appgroup --shell /bin/false --no-create-home appuser

# 3. Application code
COPY --chown=appuser:appgroup . .

# 4. Drop privileges
USER appuser

EXPOSE 8000

# 5. Healthcheck endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/')" || exit 1

# 6. Startup command
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
