# syntax=docker/dockerfile:1
# ==============================================================================
# Dockerfile Template for FastAPI Applications (uv-accelerated)
# ==============================================================================

# 1. Base image arguments and initialization
ARG PYTHON_VERSION=3.12-slim
FROM python:${PYTHON_VERSION} AS base

# 2. Package manager: Copy pre-compiled uv binary from official Astral image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 3. Environment configurations: Optimize Python runtime behavior
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1

# 4. Workdir: Establish isolated application working directory
WORKDIR /app

# 5. Layer caching: Copy requirements manifest and install dependencies using uv before copying application code
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements.txt

# 6. Security: Create an unprivileged system group and user (UID 10001)
RUN groupadd --gid 10001 appgroup && \
    useradd --uid 10001 --gid appgroup --shell /bin/false --no-create-home appuser

# 7. Application code: Copy source code with non-root user permissions
COPY --chown=appuser:appgroup . .

# 8. Security: Switch from root to unprivileged user
USER appuser

# 9. Metadata: Expose standard FastAPI port
EXPOSE 8000

# 10. Healthcheck: Healthcheck endpoint probing container status
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/')" || exit 1

# 11. Runtime execution: Start ASGI server binding to 0.0.0.0 for external network reachability
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
